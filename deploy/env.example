# Tasker deployment configuration (copy to .env and edit).
# The Compose file requires these when using the postgres/mysql profiles.

# Password for the dedicated `tasker` database user (REQUIRED for postgres/mysql).
TASKER_DB_PASSWORD=change-me-strong

# MySQL root password (REQUIRED for the mysql profile).
TASKER_DB_ROOT_PASSWORD=change-me-too

# Public port for the web UI.
TASKER_HTTP_PORT=8088

# Comma-separated origins allowed for CORS and state-changing requests.
# Empty means same-origin only (correct when served through the bundled proxy).
TASKER_ALLOWED_ORIGINS=

# Session lifetime in hours (default 336 = 14 days).
# TASKER_SESSION_TTL_HOURS=336
